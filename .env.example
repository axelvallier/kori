# Gabarit des variables d'environnement. Copier en .env.local et remplir.
# Les valeurs reelles ne sont jamais versionnees : ce repo est public.

# URL du projet Supabase, visible du navigateur, de la forme https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Cle publiable Supabase (sb_publishable_...), publique par conception, bornee par les politiques RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cle secrete Supabase (sb_secret_...), contourne toutes les politiques RLS : serveur uniquement, jamais prefixee NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
